{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example/account.schema.json",
  "title": "account",
  "type": "object",
  "required": [
    "id",
    "handle",
    "displayName",
    "region",
    "role",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^acc_"
    },
    "handle": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,29}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "enum": [
        "in",
        "eu",
        "us"
      ]
    },
    "role": {
      "enum": [
        "user",
        "admin"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
