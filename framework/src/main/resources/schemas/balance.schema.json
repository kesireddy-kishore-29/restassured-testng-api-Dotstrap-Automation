{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example/balance.schema.json",
  "title": "balance",
  "type": "object",
  "required": [
    "availableBalance",
    "currency",
    "accountId"
  ],
  "properties": {
    "availableBalance": {
      "type": "integer",
      "minimum": 0
    },
    "currency": {
      "const": "credits"
    },
    "accountId": {
      "type": "string",
      "pattern": "^acc_"
    }
  }
}
