{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example/purchase.schema.json",
  "title": "purchase",
  "type": "object",
  "required": [
    "id",
    "packId",
    "credits",
    "balanceAfter",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^pur_"
    },
    "packId": {
      "enum": [
        "pack-10",
        "pack-50"
      ]
    },
    "credits": {
      "type": "integer",
      "minimum": 1
    },
    "balanceAfter": {
      "type": "integer",
      "minimum": 0
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
