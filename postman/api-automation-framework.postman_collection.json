                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('201 Created with Location', () => {",
                      "  pm.response.to.have.status(201);",
                      "  pm.response.to.have.header('Location');",
                      "});",
                      "pm.test('served from the home region', () => pm.response.to.have.header('X-Served-Region', 'eu'));"
                    ]
                  }
                }
              ]
