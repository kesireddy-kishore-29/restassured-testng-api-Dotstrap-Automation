  "item": [
    {
      "name": "Reference service",
      "item": [
        {
          "name": "01 Health",
          "item": [
            {
              "name": "Health is UP",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/health",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "health"
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('200 and UP', () => {",
                      "  pm.response.to.have.status(200);",
                      "  pm.expect(pm.response.json().status).to.eql('UP');",
                      "});",
                      "pm.test('three regions', () => pm.expect(pm.response.json().regions).to.have.members(['in','eu','us']));",
                      "pm.test('security headers', () => {",
                      "  pm.response.to.have.header('X-Content-Type-Options', 'nosniff');",
                      "  pm.response.to.have.header('X-Frame-Options', 'DENY');",
                      "});"
                    ]
                  }
                }
              ]
            }
          ]
        },
