                      "// Unique, recognisable data per run; nothing is shared with earlier runs.",
                      "const id = () => Math.random().toString(16).slice(2, 12);",
                      "pm.collectionVariables.set('avaHandle', 'qa-pm-' + id());",
                      "pm.collectionVariables.set('benHandle', 'qa-pm-' + id());",
                      "pm.collectionVariables.set('password', 'pw-' + id() + id());",
                      "pm.collectionVariables.set('idemKey', 'qa-pm-' + id() + id());"
                    ]
