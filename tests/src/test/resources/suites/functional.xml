<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Happy-path behaviour of accounts and conversations. -->
<suite name="functional" parallel="methods" thread-count="4" data-provider-thread-count="4">
  <test name="functional">
    <groups>
      <run>
        <exclude name="quarantine"/>
        <exclude name="demo-failure"/>
      </run>
    </groups>
    <packages>
      <package name="com.qaautomation.tests.functional"/>
    </packages>
  </test>
</suite>
