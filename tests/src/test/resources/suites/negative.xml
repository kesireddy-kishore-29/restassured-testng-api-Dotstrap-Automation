<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- 401/403/404/409/415/422/402 problems, data-driven where it reads better. -->
<suite name="negative" parallel="methods" thread-count="4" data-provider-thread-count="4">
  <test name="negative">
    <groups>
      <run>
        <exclude name="quarantine"/>
        <exclude name="demo-failure"/>
      </run>
    </groups>
    <packages>
      <package name="com.qaautomation.tests.negative"/>
    </packages>
  </test>
</suite>
