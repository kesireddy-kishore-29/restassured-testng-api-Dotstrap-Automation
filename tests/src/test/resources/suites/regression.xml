<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Everything that gates a release: every layer, both targets. -->
<suite name="regression" parallel="methods" thread-count="4" data-provider-thread-count="4">
  <test name="regression">
    <groups>
      <run>
        <exclude name="quarantine"/>
        <exclude name="demo-failure"/>
      </run>
    </groups>
    <packages>
      <package name="com.kishore.qa.tests.*">
        <exclude name="com.kishore.qa.tests.demo"/>
      </package>
    </packages>
  </test>
</suite>
