<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Idempotency under retries, client timeouts, 503 + Retry-After. -->
<suite name="resilience" parallel="methods" thread-count="4" data-provider-thread-count="4">
  <test name="resilience">
    <groups>
      <run>
        <exclude name="quarantine"/>
        <exclude name="demo-failure"/>
      </run>
    </groups>
    <packages>
      <package name="com.qaautomation.tests.resilience"/>
    </packages>
  </test>
</suite>
