<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Fast gate for every push and pull request. -->
<suite name="smoke" parallel="methods" thread-count="4">
  <test name="smoke">
    <groups>
      <run>
        <include name="smoke"/>
        <exclude name="quarantine"/>
        <exclude name="demo-failure"/>
      </run>
    </groups>
    <packages>
      <package name="com.kishore.qa.tests.*"/>
    </packages>
  </test>
</suite>
