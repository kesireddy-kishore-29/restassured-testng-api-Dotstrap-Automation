<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- A fast check: the smoke-tagged tests from every package. The pull-request gate is pr-gate.xml. -->
<suite name="smoke" parallel="methods" thread-count="4">
  <test name="smoke">
    <groups>
      <run>
        <include name="smoke"/>
        <exclude name="quarantine"/>
        <exclude name="demo-failure"/>
      </run>
    </groups>
    <packages>
      <package name="com.qaautomation.tests.*"/>
    </packages>
  </test>
</suite>
